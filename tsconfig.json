{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  // The donor pin builds with Vite and Vue and has its own tsconfig.
  // We type-check our own code, not the vendored code.
  "include": ["src", "tools"],
  "exclude": ["vendor", "node_modules", "submodules"]
}
